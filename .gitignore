# --- publication hygiene: never commit reference material or voice assets ---
# Copyrighted reference documents (grammar books, papers) — for local use only.
*.pdf
*.djvu
# Reference voice sample + its transcript (cloning asset, not for public repo).
/Viktoria/
viktoria_bg.txt
# Stray local binary / scratch that slipped into the tree.
/sqlite3

# --- generated run outputs (kept ON DISK, just not versioned) ---
# Synthesized reading sets (wavs already ignored; these are the marked-text inputs
# regenerated by mark_chitanka_text.py / build_starved_readings.py).
/reading/
# Run logs, pid files and the harvest command/rc breadcrumbs.
/logs/
# bon eval: the sentence set IS tracked; the rendered wavs and picks are not.
/bon_eval/picked/
/bon_eval/wavs/
# Jupyter autosaves.
**/.ipynb_checkpoints/
# Root scratch inputs (ad-hoc synth tests).
/30s.txt
/example.txt
/examples/example.txt

# --- publication hygiene, continued: reference-voice transcripts & client copy ---
# Transcript of a named person's reference clip — same category as viktoria_bg.txt.
/examples/viktor_nikolaev_20s.txt
# Personal messages addressed to named individuals.
/examples/gimmick_rusiychev.txt
/examples/joro_konsko.txt
# Third-party commercial ad copy (brand + prices).
/examples/reklama_home_max.txt

# ASR serving venv (sherpa-onnx only; the training venv/ is separate and also ignored)
/venv-asr/
# Exported ASR model binaries (rebuild with zipformer/export-onnx.py; MODEL_CARD.json IS tracked)
/models/asr/**/*.onnx
