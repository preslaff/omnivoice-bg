# systemd unit for the OmniVoice-BG volunteer collector (runs on the VPS).
#
# The collector needs NO GPU and NO ML deps — only fastapi + uvicorn +
# python-multipart, plus ffmpeg (optional, for the submit-time duration gate)
# and the two prompt files (config/bg/imperative_verbs.txt + imperative_frames.txt).
#
# Install:
#   # 1. put the repo on the VPS (need: collect.py + config/bg/*.txt + deploy/logo.png)
#   sudo apt install ffmpeg python3-venv
#   python3 -m venv /opt/omnivoice/venv
#   /opt/omnivoice/venv/bin/pip install fastapi uvicorn python-multipart
#   # 2. edit paths below to match, then:
#   sudo cp deploy/omnivoice-collect.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now omnivoice-collect
#   journalctl -u omnivoice-collect -f          # watch it start
#
# Bound to 127.0.0.1 so ONLY nginx can reach it (see the nginx conf).

[Unit]
Description=OmniVoice-BG volunteer voice collector
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/omnivoice
ExecStart=/opt/omnivoice/venv/bin/python -m omnivoice.cli.collect \
    --host 127.0.0.1 --port 8003 \
    --out-dir /opt/omnivoice/data/bg/imperatives_volunteer
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
